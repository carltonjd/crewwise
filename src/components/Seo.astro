---
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Path such as /roofing/. Defaults to the current page path. */
  path?: string;
  /** Absolute or root-relative image. Defaults to /og.jpg. */
  image?: string;
  imageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = '/og.jpg',
  imageAlt = 'Crewwise logo on a blue field of overlapping paper planes with the headline: Win the first minute with every new client. A booking slip reads Consultation booked, Thu 10:00 AM.',
  ogTitle,
  ogDescription,
  noindex = false,
} = Astro.props;
const canonical = new URL(path, SITE.domain).toString();
// ?v= makes apps that cached an earlier preview fetch the new image; bump it when the images change.
const imageUrl = new URL(image, SITE.domain).toString() + (image.startsWith('/') ? '?v=2' : '');
---

<title>{title}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="theme-color" content="#0F1B33" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.brand} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle ?? title} />
<meta name="twitter:description" content={ogDescription ?? description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
