---
/** Head band of an inner page: the one h1, an optional lead and room for actions, on the Crewwise blue field. */
interface Props {
  heading: string;
  lead?: string;
  /** display is the big headline scale; large suits long titles. */
  size?: 'display' | 'large';
  /** let the aside slip sink onto the floor edge (default: it sits clear above it). */
  sink?: boolean;
}
const { heading, lead, size = 'display', sink = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="head ground-blue" aria-labelledby="page-title">
  <!-- the world: a darker offset sheet with one nicked corner behind the right half, and the blue-deep floor with its cut edge along the bottom -->
  <div class="deco" aria-hidden="true">
    <svg class="sheet" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polygon points="14,12 86,0 100,15 100,110 0,110" />
    </svg>
    <svg class="floor" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      <polygon points="0,80 17,66 36,50 57,33 79,16 100,0 100,101 0,101" />
      <polyline
        points="0,80 17,66 36,50 57,33 79,16 100,0"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </div>
  <div class:list={['page', 'inner', { 'has-aside': hasAside, sink }]}>
    <h1 id="page-title" class:list={['title', { large: size === 'large' }]}>{heading}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    {hasAside && <div class="aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .head {
    --fh: clamp(3rem, 2rem + 4vw, 5.5rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3.5rem, 2rem + 6vw, 7.5rem) clamp(4rem, 2.5rem + 5vw, 7rem);
  }
  .deco {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .sheet,
  .floor {
    position: absolute;
    display: block;
    overflow: visible;
  }
  /* the offset sheet: one step darker than the floor, lifted by a soft shadow, lower right of the band */
  .sheet {
    right: -4%;
    top: 66%;
    bottom: 0;
    width: 62%;
    height: auto;
    filter: drop-shadow(0 10px 22px rgb(15 27 51 / 0.38));
  }
  .sheet polygon {
    fill: var(--blue-sheet);
  }
  .floor {
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--fh);
  }
  .floor polygon {
    fill: var(--blue-deep);
  }
  .floor polyline {
    fill: none;
    stroke: var(--white);
    stroke-opacity: 0.26;
    stroke-width: 2px;
    stroke-linejoin: round;
  }
  @media (min-width: 56rem) {
    .sheet {
      right: 3%;
      top: 10%;
      width: 40%;
    }
  }
  @media print {
    .deco {
      display: none;
    }
    .head {
      padding-block: 1rem 0;
    }
  }
  .inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: clamp(1.25rem, 1rem + 1vw, 2rem);
  }
  @media (min-width: 56rem) {
    .inner.has-aside {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      column-gap: clamp(2rem, 1rem + 4vw, 5rem);
      align-items: start;
    }
    .inner.has-aside > :not(.aside) {
      grid-column: 1;
    }
    .aside {
      grid-column: 2;
      grid-row: 1 / span 4;
      align-self: center;
    }
    .inner.sink .aside {
      align-self: end;
      margin-bottom: calc(var(--fh) * -0.55);
    }
  }
  .title {
    margin: 0;
    max-width: 14ch;
    color: #fff;
    font-weight: 800;
    font-size: clamp(2.5rem, 1.2rem + 5.6vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .title.large {
    max-width: 28ch;
    font-size: clamp(2.25rem, 1.2rem + 4vw, 4rem);
  }
  .title.large ~ .lead {
    max-width: 64ch;
  }
  .lead {
    margin: 0;
    max-width: 44ch;
    color: rgb(255 255 255 / 0.9);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    line-height: 1.5;
  }
</style>
