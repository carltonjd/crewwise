---
/**
 * Who it's for: two audiences, each with a small plate from the cut-paper set
 * (a house for home-service companies, a columned office for firms).
 * The second column sits lower so the pair reads as a sequence, not a template.
 */
interface Audience {
  title: string;
  quote: string;
  note?: string;
  href?: string;
}
interface Props {
  id: string;
  heading: string;
  audiences: Audience[];
}
const { id, heading, audiences } = Astro.props;
const plates = [`<svg class="illo" viewBox="0 0 240 168" focusable="false">
<clipPath id="wa-g"><path d="M-1.1 -1.4 72.3 0 152 -2.5 225.7 -1.3 239.2 13.3 240.4 85.2 239.9 167.4 155.9 168.2 86 167.7 1.3 169.5 1.2 82.3Z"></path></clipPath><path class="f-b" d="M-1.1 -1.4 72.3 0 152 -2.5 225.7 -1.3 239.2 13.3 240.4 85.2 239.9 167.4 155.9 168.2 86 167.7 1.3 169.5 1.2 82.3Z"></path><g clip-path="url(#wa-g)"><path class="f-bd" d="M81 171 156.7 119.4 243.9 61.1 244.1 172 158.6 171.1Z"></path><path class="f-bs" d="M171.9 172.6 243.1 118.5 243.2 172.1Z"></path></g>
<clipPath id="wa-w"><path d="M61.5 81.1 173.9 82.6 174.1 158 61.2 157.6Z"></path></clipPath>
