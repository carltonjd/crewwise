<path class="f-lb" d="M138 104.2 160.3 103.4 160.4 126 138 126.5Z"></path>
<path class="f-n" d="M200.3 86.4 206.4 89.4 201.6 98.6 208.7 102.1 214 93 219.6 96.9 214 109.6 204.7 112.1 186.3 146.9 180.2 148 177.5 142 195.5 107.5 192.9 98.4Z"></path>
</svg>`, `<svg class="illo" viewBox="0 0 240 168" focusable="false">
<clipPath id="wb-g"><path d="M0.2 0.7 79.3 1 154.4 0.4 227.2 0.7 238.5 13 239.6 93.3 240.2 167.7 155.5 167.9 80 167 -0.3 168.1 0.2 78.5Z"></path></clipPath><path class="f-b" d="M0.2 0.7 79.3 1 154.4 0.4 227.2 0.7 238.5 13 239.6 93.3 240.2 167.7 155.5 167.9 80 167 -0.3 168.1 0.2 78.5Z"></path><g clip-path="url(#wb-g)"><path class="f-bd" d="M82.1 171.4 167.4 114 243.4 60.3 243.1 171.6 158.4 171.9Z"></path><path class="f-bs" d="M172.3 171.2 243.6 116.7 243.8 172.7Z"></path></g>
<path class="f-lb" d="M46.4 65.5 119.4 25.9 119.2 65.6Z"></path>
<path class="f-bs" d="M119.5 25.2 193.6 65.2 119.8 66.6Z"></path>
<path class="f-n" d="M52.5 65.9 124.4 65.9 188.2 65.7 188.5 80.7 119.2 80 52.4 79.9Z"></path>
<path class="f-n" d="M69.6 83.5 85.7 84.2 86.1 134.4 69.5 133.5Z"></path><path class="f-n2" d="M70 84.1 76.2 83.8 76.3 134 70 134.3Z"></path><path class="f-n" d="M98.5 83.9 114.1 84 113.8 134.3 98 133.9Z"></path><path class="f-n2" d="M98 83.7 104.1 84 103.8 134.2 98.2 134.2Z"></path><path class="f-n" d="M125.9 83.8 141.6 84.5 141.6 134 125.9 134.5Z"></path><path class="f-n2" d="M126 83.9 131.9 84.1 132.3 134.3 125.9 134Z"></path><path class="f-n" d="M154.3 83.8 170.3 84.3 170.4 134 154.2 133.7Z"></path><path class="f-n2" d="M153.7 84.3 160.1 83.9 160.3 133.8 153.7 133.8Z"></path>
