---

<section class="who band band-soft" id={id} aria-labelledby="who-title">
  <div class="page">
    <h2 id="who-title" class="who-title">{heading}</h2>
    <div class="split">
      {
        audiences.map((a, i) => (
          <article class="aud" style={`--i:${i}`}>
            <figure class="aud-plate" aria-hidden="true">
              <Fragment set:html={plates[i % plates.length]} />
            </figure>
            <h3 class="aud-title">{a.href ? <a class="link-draw" href={a.href}>{a.title}</a> : a.title}</h3>
            <p class="quote">{a.quote}</p>
            {a.note && <p class="note">{a.note}</p>}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .who {
    padding-block: clamp(4rem, 2.5rem + 5vw, 7rem);
  }
  /* the page's statement-size heading, on the left margin like every other h2 */
  .who-title {
    font-size: var(--step-section);
    font-weight: 830;
    line-height: 0.96;
    letter-spacing: -0.04em;
    color: var(--navy);
    max-width: 24ch;
    margin-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }
  .split {
    display: grid;
    gap: 3.5rem;
  }
  .aud {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
  }
  .aud-plate {
    margin: 0 0 0.5rem;
    width: min(100%, 22rem);
  }
  .aud:nth-child(1) .aud-plate {
    rotate: -1.5deg;
  }
  .aud:nth-child(2) .aud-plate {
    rotate: 1.5deg;
  }
  .aud-title {
    font-size: clamp(1.75rem, 1.35rem + 1.3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--navy);
    max-width: 16ch;
  }
  .aud-title a {
    color: inherit;
  }
  .quote {
    font-size: var(--step-1);
    line-height: 1.4;
    font-weight: 560;
    letter-spacing: -0.015em;
    color: var(--navy);
    max-width: 32ch;
  }
  .note {
    margin-top: auto;
    font-size: var(--step-sm);
    font-weight: 600;
    color: var(--ink-2);
    max-width: 40ch;
  }
  /* equal weight: both audiences get the same plate scale and heading tier, tops aligned;
     the pair differs by subject, opposite tilt and a slight offset of the second plate only */
  @media (min-width: 56rem) {
    .split {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 0.5rem + 2vw, 3rem);
      align-items: start;
    }
    .aud:nth-child(1) {
      grid-column: 1 / span 6;
    }
    .aud:nth-child(2) {
      grid-column: 7 / span 6;
    }
    .aud .aud-plate {
      width: 100%;
      max-width: 30rem;
    }
    .aud:nth-child(2) .aud-plate {
      translate: 1.5rem 0.75rem;
    }
    .aud-title {
      max-width: 16ch;
    }
  }
</style>
