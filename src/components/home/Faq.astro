---
import { SITE } from '../../config/site';
/**
 * FAQ: native disclosure rows, ruled, on a white paper sheet with a hand-cut edge laid on a soft
 * ground; the aside sits on its own small blue-deep cut plane. Rows are visible from first paint,
 * open to their measured height (::details-content with interpolate-size; instant elsewhere),
 * and the plus turns into a minus.
 */
interface Item {
  question: string;
  answer: string;
}
interface Props {
  id?: string;
  ctaLabel?: string;
  ctaHref?: string;
  heading: string;
  items: Item[];
  /** Short line under the heading, followed by a linked email. Pass an empty string to hide. */
  asideText?: string;
}
const {
  id,
  heading,
  items,
  asideText = 'Something else? Email',
  ctaLabel = 'Get my free audit',
  ctaHref = '/free-audit/',
} = Astro.props;
---

<section class="faq band band-soft" id={id} aria-labelledby="faq-title">
  <div class="page grid">
    <div class="head-plane">
      <div class="head ground-blue">
      <h2 id="faq-title" class="faq-title">{heading}</h2>
      {
        asideText && (
          <p class="aside">
            {asideText} <a class="link-draw" href={`mailto:${SITE.CONTACT_EMAIL}`}>{SITE.CONTACT_EMAIL}</a>
          </p>
        )
      }
      {ctaLabel && ctaHref && <a href={ctaHref} class="link-quiet ask">{ctaLabel}</a>}
      </div>
    </div>
    <div class="sheet">
    <div class="list">
      {
        items.map((it) => (
          <details>
            <summary>
              <span class="q">{it.question}</span>
              <svg class="icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M3 10h14" /><path class="v" d="M10 3v14" /></svg>
            </summary>
            <p set:html={it.answer} />
          </details>
        ))
      }
    </div>
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
  }
  .grid {
    display: grid;
    gap: 2rem clamp(2rem, 1rem + 4vw, 4rem);
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      align-items: start;
    }
  }
  /* the aside: its own small hand-cut plane, flat blue-deep, nicked top right */
  .head {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: 1.5rem 1.5rem 1.75rem;
    background: var(--blue-deep);
    color: var(--white);
    clip-path: polygon(0 0.8%, 52% 0, calc(100% - 1.5rem) 0.4%, 100% 1.5rem, 99.6% 58%, 100% 100%, 46% 99.3%, 0.3% 100%);
  }
  @media (min-width: 60rem) {
    .head-plane {
      position: sticky;
      top: 6.5rem;
    }
  }
  /* the sheet: white paper, soft drop shadow outside the cut edge, nicked top right */
  .sheet {
    filter: var(--drop-paper);
  }
  .list {
    background: var(--white);
    padding: 0.5rem clamp(1.25rem, 0.5rem + 2.5vw, 2.5rem) 0.75rem;
    clip-path: polygon(0 0.3%, 38% 0, 72% 0.25%, calc(100% - 2rem) 0, 100% 2rem, 99.8% 55%, 100% 99.7%, 60% 100%, 22% 99.75%, 0.15% 100%);
  }
  /* the quiet beat: the smallest band heading, held at the left while the rows scroll */
  .faq-title {
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    max-width: 12ch;
    color: var(--white);
  }
  .ask {
    margin-top: 0;
  }
  .aside {
    color: var(--on-blue-2);
    max-width: 26ch;
  }
  .aside a {
    color: var(--white);
    overflow-wrap: anywhere;
  }
  details + details {
    border-top: 1px solid var(--rule-strong);
  }
  details {
    interpolate-size: allow-keywords;
  }
  /* measured open: the content box grows from 0 to its own height, and back */
  details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size var(--dur-2) var(--ease-out-quart),
      content-visibility var(--dur-2) allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.75rem;
    padding: 1.35rem 0;
    border-radius: 6px;
    cursor: pointer;
    list-style: none;
    font-size: var(--step-1);
    font-weight: 750;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline-offset: 2px;
  }
  .q {
    transition: color var(--dur-1) var(--ease-out-quart);
  }
  summary:hover .q {
    color: var(--blue-ink);
  }
  /* plus to minus: the icon turns half a turn while its upright bar lies down onto the bar */
  .icon {
    flex-shrink: 0;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2.2;
    stroke-linecap: round;
    transition: rotate var(--dur-2) var(--ease-out-expo);
  }
  .icon .v {
    transform-origin: 10px 10px;
    transition: rotate var(--dur-2) var(--ease-out-expo);
  }
  details[open] .icon {
    rotate: 180deg;
  }
  details[open] .icon .v {
    rotate: 90deg;
  }
  details p :global(a) {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--blue-ink);
    font-weight: 650;
  }
  @media (pointer: coarse) {
    summary {
      padding-block: 1.25rem;
    }
  }
  details p {
    padding: 0 3rem 1.5rem 0;
    max-width: var(--measure);
    color: var(--ink-2);
    font-size: var(--step-0);
  }
  /* the answer arrives with the height; where the height cannot animate, it still fades in */
  @media (prefers-reduced-motion: no-preference) {
    details[open] p {
      animation: open var(--dur-2) var(--ease-out-quart);
    }
  }
  @keyframes open {
    from {
      opacity: 0.6;
      translate: 0 -6px;
    }
  }
</style>
