  @keyframes stamp {
    0%,
    44% {
      opacity: 0.6;
      transform: rotate(-4deg) scale(1.3);
    }
    52%,
    100% {
      opacity: 1;
      transform: rotate(-4deg) scale(1);
    }
  }
</style>

<script>
  const NATIVE =
    typeof CSS !== 'undefined' &&
    CSS.supports('animation-timeline: view()') &&
    CSS.supports('timeline-scope: --a');

  function initStory() {
    const story = document.querySelector<HTMLElement>('[data-story]');
    if (!story || story.dataset.init) return;
    story.dataset.init = '1';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduce.matches) return;

    if (NATIVE) {
      story.classList.add('is-native');
      return;
    }

    // fallback: read each timeline's cover progress once per frame, then write the variables
    story.classList.add('is-scrub');
    const sources: [string, HTMLElement][] = [
      ...story.querySelectorAll<HTMLElement>('[data-tl]'),
    ].map((el) => [el.dataset.tl!, el]);
    sources.push(['day', story]);

    const cover = (el: Element, vh: number) => {
      const r = el.getBoundingClientRect();
      const p = (vh - r.top) / (vh + r.height);
      return Math.min(0.9999, Math.max(0, p));
    };
    const update = () => {
      const vh = window.innerHeight;
      const tl = sources.map(([k, el]) => [k, cover(el, vh)] as const);
      tl.forEach(([k, p]) => story.style.setProperty(`--p-${k}`, p.toFixed(4)));
    };

    let ticking = false;
    let near = false;
    const onScroll = () => {
      if (!near || ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    new IntersectionObserver(
      ([e]) => {
        near = e.isIntersecting;
        if (near) update();
      },
      { rootMargin: '50% 0px' },
    ).observe(story);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
  document.addEventListener('astro:page-load', initStory);
</script>
