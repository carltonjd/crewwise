                        <!-- status pill, centred under the disc and name: the dot is grey during the call and green once booked -->
                        <rect x="12" y="164" width="176" height="32" rx="12" fill="#EEF3FB" />
                        <circle class="sd" cx="23.5" cy="180" r="4" fill="#1F7547" />
                        <text
                          class="t-st t-sa"
                          x="32"
                          y="184"
                          font-weight="650"
                          font-size="10"
                          letter-spacing="-.1"
