                        <rect x="39" y="317" width="6" height="11" rx="3" />
                        <path d="M35.25,325 a6.75,6.75 0 0 0 13.5,0 h-1.5 a5.25,5.25 0 0 1 -10.5,0 Z" />
                        <rect x="41.25" y="331" width="1.5" height="4" rx=".75" />
                        <circle cx="92" cy="326" r="18" fill="#E8EEFB" />
                        <circle cx="86" cy="320" r="1.5" />
                        <circle cx="92" cy="320" r="1.5" />
                        <circle cx="98" cy="320" r="1.5" />
                        <circle cx="86" cy="326" r="1.5" />
                        <circle cx="92" cy="326" r="1.5" />
                        <circle cx="98" cy="326" r="1.5" />
                        <circle cx="86" cy="332" r="1.5" />
                        <circle cx="92" cy="332" r="1.5" />
                        <circle cx="98" cy="332" r="1.5" />
                        <rect x="124" y="308" width="52" height="36" rx="18" />
                        <text
