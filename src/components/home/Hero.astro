              </g>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>

  <div class="page finerow">
    <p class="fine">Example booking for Keystone Home Inspections, a fictional company.</p>
    <button class="rep" type="button" data-hero-replay>
      Replay example call
    </button>
  </div>
</section>

<style>
  .hero {
    /* the phone is the stage: big, right of centre, high enough to stand beside the headline and long enough to be
       cropped by the fold. Its width follows the height, so the call screen clears the fold; --pl is its left edge,
       kept 3rem clear of the headline's right end */
    --fs: clamp(2.5rem, min(6.4vw, calc(8.9vw - 33px)), 6rem);
    --pt: calc(var(--mast-rule) + 1.7rem);
    --pw: min(34svh, 31vw, 440px);
    /* the headline's right end: its longest line measures 9.12 times the font size (measured at 1440, 1366, 1280,
       1180 and 1024). The phone's left edge keeps 3rem clear of it at the headline's height, allowing for the
       bezel leaning back by about 0.12 of the phone's width. */
    --h1r: calc(max(0px, (100vw - var(--page-max)) / 2) + var(--gutter) + var(--fs) * 9.13);
    --pl: min(calc(var(--h1r) + 3rem + var(--pw) * 0.12), calc(100vw - var(--pw) - 3.5rem));
    position: relative;
    isolation: isolate;
    /* shorter than the fold on tall screens: the floor band under the copy stays tight and the phone is cropped by it */
    height: min(100svh, max(34rem, calc(var(--pt) + var(--pw) * 1.82 - 3rem)));
    min-height: 34rem;
    overflow: hidden;
    background: var(--blue);
    color: var(--white);
  }
  /* the masthead (bar, oversized wordmark and its rule) is fixed over the top of the hero, so its height is reserved here */
  .top {
    position: relative;
    padding-top: calc(var(--mast-rule) + 1.5rem);
  }
  .top h1,
  .intro {
    position: relative;
    z-index: 3;
  }
  .hero h1 {
    margin: 0;
    max-width: 9.5em;
    color: var(--white);
    font-weight: 900;
    font-size: var(--fs);
    line-height: 0.96;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .intro {
    margin-top: 1.1rem;
  }
  .lead {
    margin: 0;
    max-width: 38ch;
    color: var(--on-blue-2);
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.5;
  }
  .acts {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(1.1rem, 2.6svh, 1.75rem);
  }
  .acts .btn {
    flex: none;
    min-height: 3.5rem;
    padding-inline: 2rem;
    font-size: 1.0625rem;
  }
  /* the quiet link and Replay share one state language: a solid white underline that thickens on
     hover and dims slightly on press; focus is the white ring every control on blue gets */
  .hear,
  .rep {
    text-decoration-line: underline;
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
    transition:
      text-decoration-thickness 160ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }
  .hear {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.0625rem;
    text-underline-offset: 0.35em;
  }
  .hear:hover,
  .rep:hover {
    color: var(--white);
    text-decoration-color: currentColor;
    text-decoration-thickness: 3px;
  }
  .hear:active,
  .rep:active {
    opacity: 0.8;
  }
  .acts .btn:focus-visible,
  .hear:focus-visible,
  .rep:focus-visible {
    outline-offset: 4px;
  }
  .note {
    margin: 0.7rem 0 0;
    max-width: 34em;
    font-size: 0.9375rem;
    color: var(--on-blue-2);
  }

  /* the art spans the hero's width, starting at the phone's top. The floor is a static, full-bleed sheet of
     blue-deep paper with a slanted, pale-edged top: the copy and the phone stand on the same ground. */
  .art {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    top: var(--pt);
    height: calc(var(--pw) * 2.16);
    pointer-events: none;
  }
  /* the floor hangs off the bottom of the copy block: its highest point is at the right, its lowest (the
     left end) sits 2rem under the note, so the cut edge runs just under the call to action. Full-bleed, behind the art. */
  .floor {
    --cut: clamp(2.5rem, 5vw, 4.5rem);
    position: absolute;
    z-index: 1;
    left: calc(50% - 50vw);
    width: 100vw;
    top: calc(100% + 2rem - var(--cut) * 0.94);
    height: 200vh;
    pointer-events: none;
  }
  .floor::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--cut) - 1px);
    bottom: 0;
    background: var(--blue-deep);
  }
  .edge {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: var(--cut);
    overflow: visible;
  }
  .edge polygon {
    fill: var(--blue-deep);
  }
  /* the one pale cut line in the hero */
  .edge polyline {
    fill: none;
    stroke: var(--white);
    stroke-opacity: 0.26;
    stroke-width: 2px;
    stroke-linejoin: round;
  }
  /* the diorama: three flat layers (sheet, phone, slip) stacked in one box. Everything stays 2D at all times, so
     the phone's text rasterises crisply at any pixel ratio: no perspective, no preserve-3d, no translateZ,
     no will-change, and no layer carries a scale. The stage is drawn around the phone (it sits 40 units in,
     24 down, of a 552 unit box, 200 units = --pw), so the slip reaches out to the phone's left. */
  .stage {
    position: absolute;
    top: calc(var(--pw) * -0.12);
    left: calc(var(--pl) - var(--pw) * 0.2);
    width: calc(var(--pw) * 2.76);
  }
  .defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .dio {
    position: relative;
    aspect-ratio: 552 / 488;
  }
  .lyr {
    position: absolute;
    inset: 0;
  }
  /* the sheet: --blue-sheet (blue-deep with navy mixed in) so it reads against both the blue ground and the floor; a soft shadow lifts it */
  .lyr[data-z='-120'] .fg {
    filter: drop-shadow(0 10px 22px rgb(15 27 51 / 0.38));
  }
  .sheet {
    fill: var(--blue-sheet);
  }
  /* the phone sits on the sheet; a soft paper drop gives it lift (on a sibling shape, never on the screen) */
  .lyr[data-z='0'] .sh {
    filter: var(--drop-paper);
  }
  .lyr .fg {
    text-rendering: geometricPrecision;
  }
  .lyr svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* the slip carries the soft paper shadow (--shadow-paper as an SVG drop-shadow) */
  .lyr[data-z='90'] .sh .slip {
    filter: var(--drop-paper);
  }
  /* a 44px target whose label still sits on the row's edge: the padding is given back as negative margin */
  .rep {
    display: none;
    min-height: 2.75rem;
    margin: 0 -0.75rem;
    padding: 0 0.75rem;
    background: none;
    border: 0;
    color: var(--white);
    font: inherit;
    font-weight: 650;
    font-size: 0.9375rem;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }
  .finerow {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.25rem 1.5rem;
  }
  .fine {
    margin: 0;
    max-width: 40em;
    font-size: 0.875rem;
    color: var(--on-blue-2);
  }
  /* the tap, press and Calling dots animate around their own centres */
  .pc {
    transform-box: fill-box;
    transform-origin: center;
  }
  .vb {
    transform-box: view-box;
    transform-origin: 300px 240px;
  }
  .sl-s {
    display: none;
  }
  .slip,
  .slcirc {
    transform-box: fill-box;
    transform-origin: center;
  }
  .w {
    display: inline-block;
  }

  /* final state: the default (no JS, reduced motion, crawlers) */
  .hs {
    transform: rotate(-5deg);
  }
  .web,
  .calling,
  .tdot,
  .ring {
    opacity: 0;
  }
  /* the call has ended: the waveform rests as a low, flat trace under the timer and the screen reads Call ended */
  .wv {
    fill-opacity: 0.25;
  }
  .wv rect {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleY(0.4);
  }
  .t-bk,
  .t-sa {
    opacity: 0;
  }

  /* entrance, from load: headline words rise in a short stagger, then the sub-line and actions, the floor lays down,
     the phone arrives (the story starts from [data-play] about 1.3s in). Transform and opacity only. */
  @media (prefers-reduced-motion: no-preference) {
    /* only the headline words, the floor and the phone are choreographed; the sub-line, actions, note and caption
       are at rest from the first frame, and nothing that carries text starts below 0.6 opacity (--r0) */
    .w {
      /* a wipe inside each word's own box: no vertical travel, so no frame crosses the sub-line */
      animation: hero-wipe 0.7s var(--ease-out) calc(0.05s + var(--i) * 0.055s) both;
    }
    .floor {
      --ry: 40px;
      animation: hero-rise 1.1s var(--ease-out) 0.3s both;
    }
    .lyr[data-z='-120'] {
      --ry: 44px;
      animation: hero-rise 1.1s var(--ease-out) 0.55s both;
    }
    .lyr[data-z='0'] {
      --ry: 56px;
      --r0: 0.6;
      animation: hero-rise 1.1s var(--ease-out) 0.75s both;
    }
    :global(.js) .hero .slcirc {
      transform: scale(0.6);
    }
    :global(.js) .hero[data-play]:not([data-restart]) .slcirc {
      animation: pop 0.45s var(--ease-out) 5.5s both;
    }
  }

  /* playback: JS flag set, motion allowed. JS sets [data-play] when the artwork scrolls into view;
     Replay sets [data-restart] for a frame. Timeline from [data-play], in seconds:
     touch dot glides in 1.2-1.5, tap (press and ripple) 1.5, call screen 2.0, answered 3.4-3.8, call ends 5.0 (label, pill, waveform), slip 5.1, check 5.7. */
  @media (prefers-reduced-motion: no-preference) {
    /* Replay appears once the story has started, so it is never shown when it would do nothing */
    :global(.js) .hero[data-play] .rep {
      display: inline-flex;
      align-items: center;
    }
    /* before play: the website waits on the screen */
    :global(.js) .hero .web,
    :global(.js) .hero .calling {
      opacity: 1;
    }
    :global(.js) .hero .call {
      transform: translateX(210px);
    }
    :global(.js) .hero .ans {
      opacity: 0;
    }
    :global(.js) .hero .slip {
      opacity: 0;
    }
    :global(.js) .hero .t-bk {
      opacity: 1;
    }
    :global(.js) .hero .t-ce,
    :global(.js) .hero .t-sh {
      opacity: 0;
    }
    :global(.js) .hero .t-sa {
      opacity: 1;
    }
    /* the status dot is navy-grey for the whole call and turns green only when the slip books it */
    :global(.js) .hero .sd {
      fill: #0f1b33;
      fill-opacity: 0.4;
    }
    :global(.js) .hero .wv {
      fill-opacity: 0.6;
      opacity: 1;
    }
    /* the call ends at 5.0, just before the slip moves in: status, label and waveform all settle together */
    :global(.js) .hero[data-play]:not([data-restart]) .t-bk,
    :global(.js) .hero[data-play]:not([data-restart]) .t-sa {
      animation: out 0.15s linear 4.85s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .t-ce,
    :global(.js) .hero[data-play]:not([data-restart]) .t-sh {
      animation: in 0.2s linear 5s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .sd {
      animation: sdgreen 0.3s linear 5.1s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .wv {
      animation: wvfade 0.3s linear 4.85s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .tdx {
      animation: tdx 0.3s cubic-bezier(0.3, 0.55, 0.4, 1) 1.2s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .tdy {
      animation: tdy 0.3s cubic-bezier(0.5, 0.1, 0.5, 1) 1.2s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .tdot {
      animation: tdot 0.6s linear 1.2s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .callbtn {
      animation: press 0.36s ease-in-out 1.5s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .cbf {
      animation: lift 0.36s ease-in-out 1.5s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .ring {
      animation: hero-ripple 0.62s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
      animation-delay: calc(1.5s + var(--i) * 0.13s);
    }
    :global(.js) .hero[data-play]:not([data-restart]) .wv rect {
      animation: wv 0.35s ease-in-out both 3 alternate;
      animation-delay: calc(3.8s + var(--i) * 0.08s);
    }
    :global(.js) .hero[data-play]:not([data-restart]) .call {
      animation: wipe 0.38s cubic-bezier(0.4, 0.1, 0.2, 1) 2s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .dot {
      animation: dp 0.6s ease-in-out 2 both;
      animation-delay: calc(2.4s + var(--i) * 0.14s);
    }
    :global(.js) .hero[data-play]:not([data-restart]) .calling {
      animation: out 0.2s linear 3.4s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .ans {
      animation: in 0.2s linear 3.5s both;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .slip {
      animation:
        slide 0.9s cubic-bezier(0.16, 1, 0.3, 1) 5.1s both,
        in 0.2s linear 5.1s both;
    }
    :global(.js) .hero .slipchk {
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
    }
    :global(.js) .hero[data-play]:not([data-restart]) .slipchk {
      animation: draw 0.4s var(--ease-out) 5.8s both;
    }
  }
  /* the touch dot's path: x eases out while y eases in, so it arrives on a short, gentle curve */
  @keyframes tdx {
    from {
      transform: translateX(52px);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes tdy {
    from {
      transform: translateY(76px);
    }
    to {
      transform: translateY(0);
    }
  }
  /* 0.3s in: fade up, land (50%), squash slightly on contact, then fade away before the call screen */
  @keyframes tdot {
    0% {
      opacity: 0;
      transform: scale(1);
    }
    20%,
    50% {
      opacity: 1;
      transform: scale(1);
    }
    60% {
      opacity: 1;
      transform: scale(0.82);
    }
    100% {
      opacity: 0;
      transform: scale(0.82);
    }
  }
  @keyframes press {
    0%,
    100% {
      transform: scale(1);
    }
    30%,
    65% {
      transform: scale(0.96);
    }
  }
  @keyframes lift {
    0%,
    100% {
      fill: #0f1b33;
    }
    30%,
    65% {
      fill: var(--blue-deep);
    }
  }
  /* white ring, r 10 to 32, fading; it shows on the navy Call now pill, and the stroke thins as it scales */
  @keyframes hero-ripple {
    0% {
      opacity: 0.9;
      transform: scale(1);
      stroke-width: 2.5px;
    }
    100% {
      opacity: 0;
      transform: scale(3.2);
      stroke-width: 0.9px;
    }
  }
  @keyframes wv {
    from {
      transform: scaleY(1);
    }
    to {
      transform: scaleY(0.4);
    }
  }
  @keyframes sdgreen {
    from {
      fill: #0f1b33;
      fill-opacity: 0.4;
    }
    to {
      fill: #1f7547;
      fill-opacity: 1;
    }
  }
  @keyframes wvfade {
    to {
      fill-opacity: 0.25;
    }
  }
  @keyframes wipe {
    from {
      transform: translateX(210px);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes dp {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }
  /* the slip lands like paper settling: it arrives from below and outside the phone on a plain ease-out, turning
     a couple of degrees as it flattens, and stops exactly at home (no overshoot) */
  @keyframes slide {
    from {
      transform: translate(var(--sx, -48px), 36px) rotate(-2.2deg);
    }
    to {
      transform: translate(0, 0) rotate(0);
    }
  }
  @keyframes pop {
    from {
      transform: scale(0.6);
    }
    to {
      transform: scale(1);
    }
  }
  /* entrance: one easing family (--ease-out, expo), final state is the natural one */
  @keyframes hero-rise {
    from {
      opacity: var(--r0, 0);
      transform: translateY(var(--ry, 14px));
    }
  }
  @keyframes hero-wipe {
    from {
      opacity: 0.6;
      clip-path: inset(-0.3em 100% -0.3em -0.1em);
    }
    to {
      opacity: 1;
      clip-path: inset(-0.3em -0.1em -0.3em -0.1em);
    }
  }
  @keyframes out {
    to {
      opacity: 0;
    }
  }
  @keyframes in {
    to {
      opacity: 1;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 40;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* the booking slip sits at the phone's lower left, overlapping its edge: scaled to the phone, placed in the 552 unit box */
  .slpos {
    transform: translate(-10px, 282px) scale(0.8) translate(-396px, -344px);
  }

  /* desktop: the slip stays with the phone. It is about 1.08 phone widths wide (372px at 1440), overlaps the phone's
     lower-left edge and reaches out onto the floor toward the copy. The fine print and Replay are its caption row,
     under the copy, centred on the slip's height. Positions are in the 552 unit stage box (1 unit = --pw / 200). */
  @media (min-width: 62.5625rem) {
    .hero {
      --gl: calc(max(0px, (100vw - var(--page-max)) / 2) + var(--gutter));
    }
    .slpos {
      transform: translate(-14px, 234px) scale(0.8) translate(-396px, -344px);
    }
    /* the caption row sits just under the floor's cut edge, close under the note (--tb is the copy block's bottom,
       measured by the script; the fallback is the 1440 measurement) */
    .finerow {
      bottom: auto;
      top: calc(var(--tb, 33rem) + 2.5rem);
    }
    /* the caption row stops short of the slip, wrapping Replay under the fine print when the room is tight */
    .finerow {
      left: var(--gl);
      right: auto;
      width: calc(var(--pl) - var(--pw) * 1.2 - var(--gl) - 1rem);
      max-width: none;
      margin: 0;
      padding: 0;
    }
  }

  /* stacked: headline, sub-line and call to action first, then the big phone with the slip over its foot, standing on the floor */
  @media (max-width: 62.5rem) {
    .hero {
      --pw: min(62vw, 330px);
      --pl: calc(50% - var(--pw) / 2);
      --sx: 48px;
      height: auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }
    .top {
      padding-top: calc(var(--mast-h) + clamp(0.5rem, 3vw, 1.25rem));
    }
    .hero h1 {
      max-width: 10em;
      font-size: clamp(2.5rem, 11vw, 4.5rem);
      text-wrap: balance;
    }
    .intro {
      margin-top: 1rem;
    }
    .lead {
      max-width: none;
      font-size: 1rem;
      line-height: 1.45;
    }
    .acts {
      flex-wrap: wrap;
      margin-top: 1.25rem;
      gap: 0.25rem 1.5rem;
    }
    .note {
      margin-top: 0.5rem;
      font-size: 0.875rem;
      line-height: 1.4;
    }
    .art {
      position: relative;
      top: auto;
      height: calc(var(--pw) * 2.3);
      margin-top: calc(var(--pw) * 0.06 + 0.5rem);
    }
    /* one ground only on phones: the floor carries the phone, no second dark sheet */
    .lyr[data-z='-120'] {
      display: none;
    }
    .slpos {
      transform: translate(252px, 336px) scale(0.62) translate(-396px, -344px);
    }
    .t-bk,
    .t-ce {
      display: none;
    }
    /* the floor carries on under the fine print, so the hero ends on one paper ground */
    .finerow {
      position: relative;
      bottom: auto;
      padding-block: 0.25rem 1rem;
    }
  }
  @media (max-width: 30rem) {
    .acts {
      flex-wrap: nowrap;
      gap: 0.5rem 1rem;
    }
    .acts .btn {
      min-height: 3.25rem;
      padding-inline: 1.5rem;
    }
    .hear {
      font-size: 1rem;
      white-space: nowrap;
    }
  }
</style>


<script>
  let ctrl: AbortController | undefined;

  function initHero() {
    ctrl?.abort();
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    ctrl = new AbortController();
    const { signal } = ctrl;
    const timers: number[] = [];
    signal.addEventListener('abort', () => timers.forEach((t) => clearTimeout(t)));

    // the caption row hangs just under the copy block: publish that block's bottom edge as --tb
    const top = hero.querySelector<HTMLElement>('.top');
    if (top) {
      const measure = () =>
        hero.style.setProperty('--tb', `${top.getBoundingClientRect().bottom - hero.getBoundingClientRect().top}px`);
      measure();
      const ro = new ResizeObserver(measure);
      ro.observe(top);
      signal.addEventListener('abort', () => ro.disconnect());
    }

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timerEl = hero.querySelector<SVGTextElement>('[data-timer]');

    // call timer: 0:00 when the call is answered, stops at 0:14 as the call ends at 5.0s (sped up to fit the beat)
    const runTimer = () => {
      if (!timerEl) return;
      timers.splice(0).forEach((t) => clearTimeout(t));
      timerEl.textContent = '0:00';
      for (let n = 1; n <= 14; n++) {
        timers.push(
          window.setTimeout(
            () => {
              timerEl.textContent = `0:${String(n).padStart(2, '0')}`;
            },
            3800 + (1200 * n) / 14,
          ),
        );
      }
    };
    const play = () => {
      if (signal.aborted) return;
      hero.setAttribute('data-play', '');
      runTimer();
    };

    hero.querySelector<HTMLButtonElement>('[data-hero-replay]')?.addEventListener(
      'click',
      () => {
        if (reduced || !hero.hasAttribute('data-play')) return;
        hero.setAttribute('data-restart', '');
        void hero.getBoundingClientRect();
        hero.removeAttribute('data-restart');
        play();
      },
      { signal },
    );

    if (reduced) return;
    if (timerEl) timerEl.textContent = '0:00';

    // the story starts once the artwork is in view
    const stage = hero.querySelector<HTMLElement>('.stage');
    const begin = () => timers.push(window.setTimeout(play, 1300));
    if (stage && 'IntersectionObserver' in window) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            seen.disconnect();
            begin();
          }
        },
        { threshold: 0.15 },
      );
      seen.observe(stage);
      signal.addEventListener('abort', () => seen.disconnect());
    } else {
      begin();
    }
  }
  document.addEventListener('astro:page-load', initHero);
</script>
