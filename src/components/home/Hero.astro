                        <g class="wv" fill-opacity=".35">
                          <rect style="--i:0" x="73" y="298" width="6" height="12" rx="3" />
                          <rect style="--i:1" x="85" y="292" width="6" height="24" rx="3" />
                          <rect style="--i:2" x="97" y="286" width="6" height="36" rx="3" />
                          <rect style="--i:3" x="109" y="294" width="6" height="20" rx="3" />
