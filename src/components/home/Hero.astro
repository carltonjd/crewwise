                        </text>
                        <text class="t-bd2" x="24" y="230">
                          wind mitigation reports.
                        </text>
                      </g>
                      <!-- Call now: a navy pill; it shrinks and lightens to blue-deep when tapped -->
                      <g class="callbtn pc">
                        <rect class="cbf" x="24" y="256" width="152" height="40" rx="20" />
