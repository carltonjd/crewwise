---
/**
 * Hero: "Tap to call", stacked stage. Full-bleed Crewwise blue field. The headline runs the full width on top in
 * two lines; the sub-line, call to action and note sit under it on the left. One big flat-cut smartphone stands
 * right of centre: it starts high beside the headline, runs past the copy block and is cropped by the fold, so
 * the call screen stays in view. It stands on a static blue-deep paper floor that runs the full width under the
 * copy and the phone alike (the fine print sits on it), with a darker offset sheet behind the phone and the
 * booking slip at its lower left. The diorama is three flat 2D layers (sheet, phone, slip): nothing tilts or
 * goes 3D, so the screen text stays sharp. The tap is abstract: a touch dot glides onto
 * Call now, the pill presses and ripples. Crisp vector geometry on an 8-unit grid, flat overlapping planes for
 * depth, soft shadows only. When the artwork scrolls into view the screen plays
 * the first minute: the company's mobile site, the tap on Call now, Calling, Answered by the AI front desk (with a
 * call timer), then the booking slip lands. The finished state (phone rotated -5deg in plane) is the default (no JS, reduced motion, crawlers).
 */
import { SITE } from '../../config/site';
interface Props {
  sub: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  note: string;
}
const { sub, ctaLabel, ctaHref, secondaryLabel, secondaryHref, note } = Astro.props;
const words = SITE.HERO_HEADLINE.split(' ');
---

<section class="hero ground-blue" aria-labelledby="hero-title" data-hero>
  <div class="page top">
    <!-- the floor: one sheet of blue-deep paper whose irregular cut edge runs just under the call to action, so the
         copy and the phone stand on the same ground. Its edge is a short svg strip; the body below it is plain fill. -->
    <div class="floor" aria-hidden="true">
      <svg class="edge" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
        <polygon points="0,94 15,82 33,70 52,52 71,31 88,13 100,0 100,101 0,101" />
        <polyline
          points="0,94 15,82 33,70 52,52 71,31 88,13 100,0"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    </div>
    <h1 id="hero-title">
      {
        words.map((w, i) => (
          <>
            <span class="w" style={`--i:${i}`}>
              {w}
            </span>
            {i < words.length - 1 ? ' ' : ''}
          </>
        ))
      }
    </h1>
    <div class="intro">
      <p class="lead">{sub}</p>
      <div class="acts">
        <a href={ctaHref} class="btn btn-primary">
          {ctaLabel}
        </a>
        <a href={secondaryHref} class="link-quiet hear">
          {secondaryLabel}
        </a>
      </div>
      <p class="note">{note}</p>
    </div>
  </div>

  <div class="art">
    <p class="visually-hidden">
      Example: a home buyer finds Keystone Home Inspections’ website on their phone and taps Call now. The
      company’s AI front desk answers the call and books an inspection for Thursday at 9:00 AM.
    </p>
      <!-- the diorama is decoration for screen readers; the paragraph above carries its story -->
      <div class="stage" aria-hidden="true">
        <!-- shared defs, referenced by every depth layer below. Art is drawn on an 8-unit grid in a 552 x 488 box. -->
        <svg class="defs" width="0" height="0" focusable="false">
          <defs>
            <clipPath id="hero-scr">
              <rect x="8" y="8" width="184" height="416" rx="32" />
            </clipPath>
            <rect id="hero-body" width="200" height="432" rx="40" />
            <path
              id="hero-glyph"
              d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
            />
          </defs>
        </svg>

        <div class="dio" data-dio>
          <!-- back (z -120): the offset sheet, a cut-paper quadrilateral in a darker blue-deep, with a pale cut edge
               on its top and left sides and a soft shadow. It reaches past the fold and the right edge. -->
          <div class="lyr plane" style="--h:0" data-z="-120">
            <svg class="fg" viewBox="160 0 552 488" focusable="false">
              <polygon class="sheet" points="212,60 330,69 452,88 640,112 640,700 -15,700 48,520 104,330 176,168" />
            </svg>
          </div>

          <!-- middle (z 0): the phone, drawn in its own 200 x 432 frame and rotated -5deg in plane about its centre (300, 240) -->
          <div class="lyr" style="--h:1" data-z="0">
            <!-- the phone's soft shadow lives on its own sibling shape, so no filter ever touches the screen layer -->
            <svg class="sh" viewBox="160 0 552 488" focusable="false">
              <g class="hs vb">
                <g transform="translate(200 24)">
                  <use href="#hero-body" fill="#0F1B33" />
                </g>
              </g>
            </svg>
            <svg class="fg" viewBox="160 0 552 488" focusable="false">
              <g class="hs vb">
                <g transform="translate(200 24)">
                  <g fill="#0F1B33">
                    <rect x="-4" y="104" width="6" height="32" rx="2" />
                    <rect x="-4" y="152" width="6" height="32" rx="2" />
                    <rect x="198" y="128" width="6" height="56" rx="2" />
                    <use href="#hero-body" />
                  </g>
                  <rect x="8" y="8" width="184" height="416" rx="32" fill="#fff" />

                  <g
                    clip-path="url(#hero-scr)"
                    font-family="'Hanken Grotesk Variable','Hanken Grotesk',system-ui,sans-serif"
