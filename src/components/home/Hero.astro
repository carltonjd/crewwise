          <!-- front (z 90): the booking slip -->
          <div class="lyr" style="--h:1.4" data-z="90">
            <svg class="sh" viewBox="160 0 552 488" focusable="false">
              <g class="slpos">
              <g class="slsc">
                <g class="slip">
                  <rect class="sl-f" x="396" y="344" width="280" height="104" rx="12" fill="#fff" />
                  <rect class="sl-s" x="396" y="344" width="280" height="84" rx="12" fill="#fff" />
                </g>
              </g>
              </g>
            </svg>
            <svg class="fg" viewBox="160 0 552 488" focusable="false">
              <g class="slpos">
              <g class="slsc">
                <g class="slip">
                  <rect class="sl-f" x="396" y="344" width="280" height="104" rx="12" fill="#fff" />
                  <rect class="sl-s" x="396" y="344" width="280" height="84" rx="12" fill="#fff" />
                  <g class="slc">
                    <circle class="slcirc" cx="438" cy="396" r="18" fill="#1F7547" />
                    <polyline
                      class="slipchk"
