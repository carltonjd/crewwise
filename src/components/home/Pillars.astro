---
import { SITE, BUILDER } from '../../config/site';
/**
 * The whole offer at a glance: three outcomes, the AI front desk leading.
 * Plain type on white; each service has a plate from the cut-paper set (.illo in global.css):
 * hand-cut planes, light from the top left told in tonal steps, one nicked corner per piece.
 * Websites and automation are deliberately unequal: a wide plate first, a tall one set lower.
 */
interface Props {
  heading: string;
  lead: string;
}
const { heading, lead } = Astro.props;
---

<section class="pillars band band-white" aria-labelledby="pillars-title">
  <div class="page">
    <div class="head">
      <h2 id="pillars-title" class="h2">{heading}</h2>
      <p class="lead">{lead}</p>
    </div>

    <article class="pillar pillar-desk" id="ai-front-desk">
      <div class="copy">
        <h3 class="title title-lead">Answer every call with an AI front desk</h3>
        <p class="text">
          It answers every call in your business name, day or night. It books the visit or
          consultation, flags anything urgent to you and follows up so leads don’t go cold.
        </p>
        <ul class="ticks">
          <li>Keeps your number</li>
          <li>Books into your calendar</li>
          <li>Texts a confirmation, once texting is on</li>
          <li>Says it’s an AI if asked</li>
        </ul>
        <p class="price">{SITE.PRICE_FRONT_DESK}</p>
      </div>

      <figure class="plate plate-desk" aria-hidden="true">
