---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Demo, { type Scene } from '../components/home/Demo.astro';
import Pillars from '../components/home/Pillars.astro';
import TeamStrip from '../components/home/TeamStrip.astro';
import SlipAway from '../components/home/SlipAway.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import WhoFor from '../components/home/WhoFor.astro';
import Faq from '../components/home/Faq.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { SITE, PLAN_LABEL } from '../config/site';
import { planFaq, deskFaq } from '../config/faq';
import { faqJsonLd, serviceJsonLd } from '../lib/jsonld';

// The website plan leads (owner decision 2026-11-25). The day story and the law firm call are switched off here,
// not deleted: they come back on a future /ai-front-desk/ page.
const SHOW_DAY_STORY = false;
const SHOW_FIRM_CALL = false;

const faq = [...planFaq.slice(0, 4), deskFaq[0], planFaq[6]];

const jsonLd = [
  serviceJsonLd({
    name: PLAN_LABEL,
    serviceType: 'Small business website, hosting and business profile setup',
    description: `${SITE.PLAN_LINE} Built by Crewwise from our templates, hosted, with small text and photo updates.`,
    path: '/#websites',
    id: 'websites',
  }),
  serviceJsonLd({
    name: 'AI front desk',
    serviceType: 'AI phone answering and appointment booking',
    description:
      'Picks up every call, day or night, books visits or consultations, flags urgent calls and follows up so leads don’t go cold.',
    path: '/#ai-front-desk',
    id: 'ai-front-desk',
  }),
  faqJsonLd(faq),
];
---

<Base
  title={`Crewwise | The ${PLAN_LABEL} for local service businesses`}
  description={`${SITE.PLAN_LINE} ${SITE.PRICE_WEBSITE_PLAN}, no setup fee. Add an AI front desk when you miss calls.`}
  imageAlt={`Crewwise logo on a blue field of overlapping paper planes with the headline: ${SITE.HERO_HEADLINE} A slip reads ${SITE.PLAN_NAME}, ${SITE.PRICE_WEBSITE_PLAN}.`}
  current="home"
  jsonLd={jsonLd}
>
  <Hero
    sub={SITE.HERO_SUB}
    ctaLabel="Get AI Ready"
    ctaHref="/free-audit/?interest=plan"
    secondaryLabel="What’s included"
    secondaryHref="/pricing/#websites"
    note="No setup fee. Month to month, with 30 days’ notice to cancel."
  />

  <Pillars
    heading="Your website and your listings, kept up for you"
    lead="Start with AI Ready. Add the AI front desk when calls start going to voicemail."
  />

  {SITE.SHOW_OCTALOGIC && <TeamStrip />}

  {SHOW_DAY_STORY && (<SlipAway
    id="the-day"
    heading="Good work still loses jobs before you get a chance"
    lead="None of these show up as a lost job. The customer just books someone else, long before anyone compares quotes."
    moments={[
      {
        time: '2:14 PM',
        who: 'Calling about a leak',
        text: 'You’re on a job. Many callers hang up instead of leaving a voicemail.',
        lost: 'Hung up, no voicemail',
        kept: 'It answered and booked the visit',
        booked: true,
      },
      {
        time: '6:40 PM',
        who: 'No heat, elderly caller',
        text: 'You’ve clocked off when an urgent call comes in.',
        lost: 'Went to voicemail',
        kept: 'Flagged urgent to you straight away',
      },
      {
        time: '7:30 PM',
        who: 'Web form, new client',
        text: 'A web inquiry gets answered that evening, after they’ve booked someone else.',
        lost: 'Booked someone else',
        kept: 'It replied and booked a consultation',
        booked: true,
      },
    ]}
    closing={{
      heading: 'After you clock off, the AI front desk keeps answering',
      text: 'Calls forward to the AI front desk after hours. Urgent ones are flagged to you straight away, and the rest are booked or set for a follow-up.',
    }}
  />)}

  <HowItWorks
    id="setup"
    heading="How AI Ready works"
    steps={[
      {
        title: 'Tell us about your business',
        when: 'Today',
        text: 'Send us your details, and we contact you about AI Ready.',
        ctaLabel: 'Get AI Ready',
        ctaHref: '/free-audit/?interest=plan',
      },
      {
        title: 'You sign up and send your content',
        when: 'Day one',
        text: 'The first month is paid when you sign up, before we start building. Then you send your logo, photos and service details.',
      },
      {
        title: 'We build it',
        when: 'About 5 business days',
        text: 'We build your website from our templates and set up your profiles on Google, Bing, Apple Maps and ChatGPT, where those services allow it. Two rounds of changes are included.',
      },
      {
        title: 'It goes live, and we keep it up',
        when: 'Every month',
        text: 'We host it, keep it online and make small text and photo updates when you ask.',
      },
    ]}
  />

  <Demo
    id="demo"
    heading="Hear the AI front desk answer a call"
    lead={`A separate service, ${SITE.PRICE_FRONT_DESK.toLowerCase()}. It answers in your business name, takes the details, flags anything urgent and books the appointment.`}
    scenes={[
      {
        id: 'service',
        tab: 'Home-service call',
        context: 'Wednesday 2:14 PM. You’re on a job across town.',
        lines: [
          { speaker: 'caller', text: 'Hi, our AC stopped working this morning and the house is getting hot.' },
          {
            speaker: 'desk',
            text: 'Sorry about that. Can I get your name and address? I’ll check the soonest time a technician can come out.',
          },
          { speaker: 'caller', text: 'Maria Lopez, 412 Oak Street.' },
          {
            speaker: 'desk',
            text: 'Thanks, Maria. I can get a technician to you tomorrow at 9 AM. Does that work?',
          },
          { speaker: 'caller', text: 'Yes, that works.' },
          { speaker: 'desk', text: 'You’re booked for Thursday at 9 AM. I’ll send you a confirmation.' },
        ],
        events: [
          { time: '2:14:02 PM', title: 'Call answered', detail: 'In your business name', kind: 'answer', after: -1 },
          { time: '2:14:20 PM', title: 'Details captured', detail: 'Maria Lopez, 412 Oak St, AC not cooling', kind: 'info', after: 2 },
          { time: '2:14:21 PM', title: 'Flagged as urgent', detail: 'No cooling on a hot day', kind: 'urgent', after: 2 },
          { time: '2:14:38 PM', title: 'Visit booked, Thu 9:00 AM', detail: 'Added to your calendar', kind: 'booked', after: 4 },
          { time: '2:14:43 PM', title: 'Confirmation sent', detail: 'You get the summary too', kind: 'text', after: 5 },
        ],
      },
      ...(SHOW_FIRM_CALL
        ? ([
      {
            id: 'firm',
            tab: 'Law firm call',
            context: 'Wednesday 11:20 AM. You’re in court.',
            lines: [
              {
                speaker: 'caller',
                text: 'Hi, I was in a car accident last week and the other driver’s insurer keeps calling me. Do I have a case?',
              },
              {
                speaker: 'desk',
                text: 'I’m sorry that happened. I can’t give legal advice, but I can book you a consultation with an attorney. Can I take your name and a number?',
              },
              { speaker: 'caller', text: 'James Carter, 555 0147.' },
              { speaker: 'desk', text: 'Thanks, James. Is tomorrow at 11 AM okay?' },
              { speaker: 'caller', text: 'Yes, tomorrow works.' },
              {
                speaker: 'desk',
                text: 'You’re booked for Thursday at 11 AM. I’ll send you a confirmation.',
              },
            ],
            events: [
              { time: '11:20:04 AM', title: 'Call answered', detail: 'In your firm’s name', kind: 'answer', after: -1 },
              { time: '11:20:19 AM', title: 'No legal advice given', detail: 'The AI front desk offers a consultation instead', kind: 'info', after: 1 },
              { time: '11:20:31 AM', title: 'Inquiry details taken', detail: 'James Carter, car accident, insurer calls', kind: 'info', after: 2 },
              { time: '11:20:52 AM', title: 'Consultation booked, Thu 11:00 AM', detail: 'Added to your calendar', kind: 'booked', after: 4 },
              { time: '11:20:58 AM', title: 'Confirmation sent', detail: 'With what to bring', kind: 'text', after: 5 },
            ],
          },
          ] satisfies Scene[])
        : []),
    ]}
  />

  <WhoFor
    id="who-its-for"
    heading="Built for local service businesses"
    audiences={[
      {
        title: 'Pressure washing, pool cleaning, auto detailing and garage doors',
        quote: `Customers look you up on their phone before they call. ${SITE.PLAN_NAME} gives them a clear website, and the same correct details on Google, Apple Maps and ChatGPT.`,
      },
      {
        title: 'Home inspectors and home-service companies',
        href: '/home-inspectors/',
        quote: 'You’re on a job when the next one calls. Start with AI Ready, and add the AI front desk when calls start going to voicemail.',
      },
    ]}
  />

  <Faq
    id="questions"
    heading="What owners ask first"
    items={faq}
    ctaLabel="Get AI Ready"
    ctaHref="/free-audit/?interest=plan"
  />

  <FinalCta
    heading="Get your business website started"
    text={`Tell us about your business, and we’ll contact you about the ${PLAN_LABEL}.`}
    ctaLabel="Get AI Ready"
    ctaHref="/free-audit/?interest=plan"
    reassurance="No setup fee. Month to month, with 30 days’ notice to cancel."
    sheet={{
      title: SITE.PLAN_NAME,
      rows: ['Your website, built from our templates', 'Google, Bing, Apple Maps and ChatGPT profiles set up'],
      foot: 'About 5 business days after we have your content',
    }}
  />
</Base>
