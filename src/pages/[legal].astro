---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';

export async function getStaticPaths() {
  const entries = await getCollection('legal');
  return entries.map((entry) => ({ params: { legal: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const updated = entry.data.updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${entry.data.title} | Crewwise`} description={entry.data.description} current="other">
  <PageHead heading={entry.data.title} size="large">
    <p class="updated">
      <span class="lbl">Last updated</span>
      <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{updated}</time>
    </p>
  </PageHead>

  <section class="body">
    <div class="page">
      <article class="legal-prose">
        <Content />
      </article>
    </div>
  </section>
</Base>

<style>
  .updated {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 600;
  }
  .updated {
    color: #fff;
  }
  .updated .lbl {
    color: rgb(255 255 255 / 0.86);
    font-weight: 500;
  }
  .body {
    padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(5rem, 3rem + 8vw, 9rem);
  }
  .legal-prose {
    max-width: 68ch;
    font-size: var(--step-0);
    line-height: 1.65;
  }
  .legal-prose > :global(* + *) {
    margin-top: 1rem;
  }
  /* email links are 44px targets */
  .legal-prose :global(a[href^='mailto:']) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .legal-prose :global(h2) {
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-weight: 800;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1.5px solid var(--rule);
  }
  .legal-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .legal-prose :global(h3) {
    font-size: var(--step-1);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 750;
    margin-top: 2rem;
  }
  .legal-prose :global(h2 + *),
  .legal-prose :global(h3 + *) {
    margin-top: 0.75rem;
  }
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    padding-left: 1.4rem;
    display: grid;
    gap: 0.5rem;
  }
  .legal-prose :global(ul) {
    list-style: disc;
  }
  .legal-prose :global(li::marker) {
    color: var(--blue);
  }
  .legal-prose :global(a) {
    overflow-wrap: anywhere;
  }
  .legal-prose :global(strong) {
    font-weight: 700;
  }
  .legal-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
  }
  .legal-prose :global(th) {
    background: var(--soft);
  }
  .legal-prose :global(th),
  .legal-prose :global(td) {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--rule-strong);
  }
</style>
